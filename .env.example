# Keys: set one or more. Order tried: Gemini, OpenRouter, Claude (AI_PROVIDER picks who goes first).
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=model-id:free,other-model-id:free   (PIN specific models; the random "openrouter/free" router can pick safety-filter models)
# OPENROUTER_WEB=1        (web search on OpenRouter, may cost credits)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ARZY_WEB=0              (turn off web search/grounding)
# AI_PROVIDER=gemini
# Music (optional): YOUTUBE_API_KEY enables full songs via an embedded YouTube player; ITUNES_COUNTRY e.g. PH or US
# YOUTUBE_API_KEY=your-youtube-data-api-key
# ITUNES_COUNTRY=US
# Full songs for song requests (pick one or both): YouTube Data API key, or Spotify app credentials
# YOUTUBE_API_KEY=...
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
# MUSIC_SOURCE=spotify   (prefer Spotify over YouTube when both are set)
